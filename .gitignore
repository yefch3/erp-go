# Binaries and tool cache
/bin/
*.exe
*.test

# Go
/vendor/
coverage.out

# IDE / agent tooling
.idea/
.vscode/
.claude/
*.swp

# Local env
.env
.env.local

# Keys and passwords generated by the AWS provisioning scripts. They exist
# only on the machine of whoever ran the script, and move to the server's
# .env by hand — never through the repository.
/deploy/aws/secrets/

# OS
.DS_Store

# Frontend build output (produced by `npm run build`, never edited by hand)
/frontend/dist/
/frontend/node_modules/

# Locally rendered spreadsheet/document QA artifacts
/outputs/

# Requirements and planning documents — local working material, never pushed
/docs/requirements/
# D1 generated local isolation configuration and runtime evidence
.d1-environment/
