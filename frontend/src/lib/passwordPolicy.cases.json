{
  "note": "密码规则的共用样例。浏览器那份（lib/passwordPolicy.ts）和服务端那份（services/iam/internal/app/passwordpolicy.go）读的是同一个文件：谁改了规则忘了改另一边，两边有一边会红。expect 是第一条没过的规则，ok 表示全过。",
  "problemToCode": {
    "tooShort": "IAM_PASSWORD_TOO_SHORT",
    "tooLong": "IAM_PASSWORD_TOO_LONG",
    "tooCommon": "IAM_PASSWORD_TOO_COMMON",
    "tooSimple": "IAM_PASSWORD_TOO_SIMPLE",
    "fromIdentity": "IAM_PASSWORD_FROM_IDENTITY"
  },
  "cases": [
    {
      "why": "十位、没规律、和本人无关",
      "password": "tRuck-plum-92",
      "context": [],
      "expect": "ok"
    },
    {
      "why": "中文一个字顶两位，六个字就够",
      "password": "今天想吃小笼包",
      "context": [],
      "expect": "ok"
    },
    {
      "why": "四个汉字只有八位，还差一点",
      "password": "小笼包醋",
      "context": [],
      "expect": "tooShort"
    },
    {
      "why": "九个拉丁字母不够十位",
      "password": "truckplum",
      "context": [],
      "expect": "tooShort"
    },
    {
      "why": "权重够十位，但只有五个字符，还是不行",
      "password": "小笼包醋辣",
      "context": [],
      "expect": "tooShort"
    },
    {
      "why": "空的也算太短",
      "password": "",
      "context": [],
      "expect": "tooShort"
    },
    {
      "why": "超过 256 位",
      "password": "aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-zP9-kL4-mN6-rT8-vC1-aB3-xY7-qW2-",
      "context": [],
      "expect": "tooLong"
    },
    {
      "why": "最常被试的那些",
      "password": "password",
      "context": [],
      "expect": "tooShort"
    },
    {
      "why": "常见密码加个 1 加个叹号还是它",
      "password": "password123!",
      "context": [],
      "expect": "tooCommon"
    },
    {
      "why": "键盘顺序",
      "password": "qwertyuiop",
      "context": [],
      "expect": "tooCommon"
    },
    {
      "why": "键盘顺序的一段",
      "password": "1234567890",
      "context": [],
      "expect": "tooCommon"
    },
    {
      "why": "六个一样的字符连着",
      "password": "aaaaaaXbcd12",
      "context": [],
      "expect": "tooSimple"
    },
    {
      "why": "六个顺着走的字符",
      "password": "Qabcdefzz19",
      "context": [],
      "expect": "tooSimple"
    },
    {
      "why": "六个倒着走的字符",
      "password": "Qfedcbazz19",
      "context": [],
      "expect": "tooSimple"
    },
    {
      "why": "五个连着还不算",
      "password": "Qabcdezz19x",
      "context": [],
      "expect": "ok"
    },
    {
      "why": "密码里带着自己的用户名",
      "password": "zhangsan-8821",
      "context": [
        "zhangsan"
      ],
      "expect": "fromIdentity"
    },
    {
      "why": "带着邮箱前缀",
      "password": "kratos-plum-92",
      "context": [
        "kratos@example.com"
      ],
      "expect": "fromIdentity"
    },
    {
      "why": "带着工号",
      "password": "x-emp2026-plum",
      "context": [
        "EMP2026"
      ],
      "expect": "fromIdentity"
    },
    {
      "why": "带着中文姓名",
      "password": "张三丰的长密码",
      "context": [
        "张三丰"
      ],
      "expect": "fromIdentity"
    },
    {
      "why": "公共后缀不算身份片段",
      "password": "com-truck-plum9",
      "context": [
        "a@example.com"
      ],
      "expect": "ok"
    },
    {
      "why": "三个字母的片段太短，不拦",
      "password": "sun-truck-plum",
      "context": [
        "sun"
      ],
      "expect": "ok"
    },
    {
      "why": "身份词只在别处出现时不算",
      "password": "tRuck-plum-92",
      "context": [
        "zhangsan"
      ],
      "expect": "ok"
    }
  ]
}
